# AI Trend Radar RAG — local Docker configuration
#
# The easiest path is to double-click setup.command (macOS/Linux) or setup.bat
# (Windows). It creates .env locally. Never commit the resulting .env file.

# Required: choose one provider and fill only its matching key.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Required by Docker Compose. setup.command / setup.bat generates a value.
NEO4J_PASSWORD=

# Optional: leave empty for the default local single-user dashboard.
# Set this only when exposing the API beyond your own computer; API clients must
# then send the X-API-Key header. The browser dashboard deliberately does not
# store this secret.
RAG_API_KEY=

# Optional product behaviour
RAG_ENABLE_DEEP_FETCH=false
RAG_CORPUS_RECHECK_DAYS=30
# Keep false while tuning/evaluating a fixed corpus. Enable only after the
# staged corpus quality gate and automatic-update workflow are accepted.
RAG_STARTUP_CORPUS_UPDATE_ENABLED=false

# Optional live-search providers. Add at least one to enable web search.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
SERPAPI_API_KEY=
GITHUB_TOKEN=
