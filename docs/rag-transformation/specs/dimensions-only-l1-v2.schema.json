{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-trend-radar.local/schemas/dimensions-only-l1-v2.schema.json",
  "title": "Dimensions-only L1 v2",
  "description": "External model output: five route-neutral semantic judgments only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dimensions"],
  "properties": {
    "schema_version": {"const": "atr.semantic-dimensions/2.0"},
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_lookup",
        "recent_update_set",
        "cross_time_or_entity_structure",
        "truth_assessable_claim",
        "explanation_or_comparison"
      ],
      "properties": {
        "item_lookup": {"$ref": "#/$defs/judgment"},
        "recent_update_set": {"$ref": "#/$defs/judgment"},
        "cross_time_or_entity_structure": {"$ref": "#/$defs/judgment"},
        "truth_assessable_claim": {"$ref": "#/$defs/judgment"},
        "explanation_or_comparison": {"$ref": "#/$defs/judgment"}
      }
    }
  },
  "$defs": {
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence_spans"],
      "properties": {
        "state": {"enum": ["present", "absent", "uncertain"]},
        "evidence_spans": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
