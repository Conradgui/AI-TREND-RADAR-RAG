{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-trend-radar.local/schemas/ordered-semantic-frame-v3.schema.json",
  "title": "AI Trend Radar Ordered Semantic Frame v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deliveries",
    "protected_spans",
    "web_permission",
    "web_evidence_spans",
    "unresolved_reference_spans"
  ],
  "properties": {
    "schema_version": {"const": "atr.ordered-semantic-frame/3.0"},
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_family",
          "evidence_spans",
          "requested_output_form",
          "locator_kind"
        ],
        "properties": {
          "task_family": {
            "enum": [
              "item_navigation",
              "trend_discovery",
              "temporal_relation_exploration",
              "claim_verification",
              "evidence_research"
            ]
          },
          "evidence_spans": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "requested_output_form": {
            "enum": [
              "exact_item",
              "item_disambiguation",
              "important_news",
              "trend_clusters",
              "timeline",
              "relation",
              "longitudinal_trend",
              "cross_sectional_trend",
              "verification_verdict",
              "explanation",
              "comparison",
              "deep_research"
            ]
          },
          "locator_kind": {
            "enum": ["atr_id", "full_title", "title_fragment", "descriptive", "none"]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"task_family": {"const": "item_navigation"}}},
            "then": {
              "properties": {
                "requested_output_form": {"enum": ["exact_item", "item_disambiguation"]},
                "locator_kind": {"enum": ["atr_id", "full_title", "title_fragment", "descriptive"]}
              },
              "allOf": [
                {
                  "if": {"properties": {"locator_kind": {"enum": ["atr_id", "full_title"]}}},
                  "then": {"properties": {"requested_output_form": {"const": "exact_item"}}}
                },
                {
                  "if": {"properties": {"locator_kind": {"enum": ["title_fragment", "descriptive"]}}},
                  "then": {"properties": {"requested_output_form": {"const": "item_disambiguation"}}}
                }
              ]
            }
          },
          {
            "if": {"properties": {"task_family": {"const": "trend_discovery"}}},
            "then": {
              "properties": {
                "requested_output_form": {"enum": ["important_news", "trend_clusters"]},
                "locator_kind": {"const": "none"}
              }
            }
          },
          {
            "if": {"properties": {"task_family": {"const": "temporal_relation_exploration"}}},
            "then": {
              "properties": {
                "requested_output_form": {"enum": ["timeline", "relation", "longitudinal_trend", "cross_sectional_trend"]},
                "locator_kind": {"const": "none"}
              }
            }
          },
          {
            "if": {"properties": {"task_family": {"const": "claim_verification"}}},
            "then": {
              "properties": {
                "requested_output_form": {"const": "verification_verdict"},
                "locator_kind": {"const": "none"}
              }
            }
          },
          {
            "if": {"properties": {"task_family": {"const": "evidence_research"}}},
            "then": {
              "properties": {
                "requested_output_form": {"enum": ["explanation", "comparison", "deep_research"]},
                "locator_kind": {"const": "none"}
              }
            }
          }
        ]
      }
    },
    "protected_spans": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claim_spans": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "subject_spans": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "retrieval_hints": {
      "description": "Optional retrieval-only paraphrases. They are never user claims, entity links, citations, or answer text.",
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2, "maxLength": 160}
    },
    "source_spans": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "web_permission": {"enum": ["forbidden", "on_demand", "explicit"]},
    "web_evidence_spans": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "unresolved_reference_spans": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"web_permission": {"enum": ["forbidden", "explicit"]}}},
      "then": {"properties": {"web_evidence_spans": {"minItems": 1}}}
    }
  ]
}
