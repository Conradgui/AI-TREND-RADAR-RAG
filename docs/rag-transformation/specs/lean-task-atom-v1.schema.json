{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-trend-radar.local/schemas/lean-task-atom-v1.schema.json",
  "title": "Lean Task Atom v1",
  "description": "Route-neutral fallback output. Route, answer mode and policy identifiers are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["main", "supporting", "references", "confidence", "ambiguities"],
  "properties": {
    "main": {"$ref": "#/$defs/taskAtom"},
    "supporting": {
      "type": "array",
      "maxItems": 2,
      "items": {"$ref": "#/$defs/taskAtom"}
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["literal_span", "status", "resolved_value"],
        "properties": {
          "literal_span": {"type": "string", "minLength": 1},
          "status": {"enum": ["resolved_in_query", "resolved_from_context", "unresolved"]},
          "resolved_value": {"type": ["string", "null"]}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "ambiguities": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "taskAtom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target_span", "success_criterion"],
      "properties": {
        "action": {"enum": ["navigate", "discover", "trace", "relate", "verify", "explain", "compare", "recommend", "research"]},
        "target_span": {"type": "string", "minLength": 1},
        "success_criterion": {"type": "string", "minLength": 1}
      }
    }
  }
}
