  "adjudication_notes": [
    {
      "case_id": "v32-new-blind-001",
      "field": "expected_delivery_evidence_spans",
      "selected": [
        [
          "打开 ATR-20260818-Q7M2K9 对应的记录"
        ],
        [
          "解释它为什么值得关注"
        ]
      ],
      "rationale": "“打开…对应的记录”同时证明导航动作与 ATR ID 定位；仅保留 ID 不足以证明交付语义。"
    },
    {
      "case_id": "v32-new-blind-001",
      "field": "expected_protected_terms",
      "selected": [
        "不要联网",
        "ATR-20260818-Q7M2K9",
        "值得关注"
      ],
      "rationale": "“值得关注”是足以保留解释目标的最小连续片段，无需额外保留疑问副词。"
    },
    {
      "case_id": "v32-new-blind-001",
      "field": "expected_critical_terms",
      "selected": {
        "atr_id": [
          "ATR-20260818-Q7M2K9"
        ],
        "negation": [
          "不要联网"
        ],
        "permission": [
          "不要联网"
        ]
      },
      "rationale": "ATR ID 与禁止联网同时改变定位和权限；禁止表达还应作为否定限定词保真，普通关注措辞不列为关键事实。"
    },
    {
      "case_id": "v32-new-blind-002",
      "field": "expected_delivery_evidence_spans",
      "selected": [
        [
          "在内部日报中定位完整标题《白鹭缓存迁移手册》对应的那一条"
        ]
      ],
      "rationale": "完整片段同时证明内部日报来源、定位动作与完整标题，单独标题短语不足以证明导航请求。"
    },
    {
      "case_id": "v32-new-blind-002",
